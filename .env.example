# API_KEY is required. This example is never copied over an existing .env.
API_KEY=
HOST=0.0.0.0
PORT=8585
INFERENCE_DEVICE=auto
QUALITY_MODEL_ENABLED=0
# Default is artifacts/windows-cuda/manifest.json on Windows,
# artifacts/windows-cpu/manifest.json with explicit CPU, or artifacts/linux-cpu/manifest.json.
# ARTIFACT_MANIFEST=artifacts/windows-cuda/manifest.json
CORS_ORIGINS=
TRUSTED_PROXIES=
QUEUE_CAPACITY=8
INPUT_BUDGET_MB=256
MEMORY_BUDGET_MB=1024
FAST_TIMEOUT=9
QUALITY_TIMEOUT=29
SHUTDOWN_GRACE=30
AUTH_MAX_ENTRIES=10000
